# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Search API Keys
TAVILY_API_KEY=your_tavily_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Speech API Keys
OPENAI_API_KEY_WHISPER=your_openai_whisper_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# SMS API Keys
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number 

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here,additional_chat_ids_separated_by_commas
TELEGRAM_ADMIN_ID=admin_chat_id_here_with_unlimited_invites
INVITE_LIMIT=5 # Regular users can create at most 5 invites, admins can create unlimited invites
TELEGRAM_ALLOWED_ALL_USERS=false # If true, all users will have access to the bot, otherwise only the users in the TELEGRAM_CHAT_ID, TELEGRAM_ADMIN_ID and invite codes will be allowed

# Agent Configuration (obsolete, now set from user settings)
MAX_AGENT_TOOLS_ITERATIONS=65
MAX_AGENT_CRITIQUE_ITERATIONS=0

# Models (optional overrides; defaults shown, single source of truth is app/models.py)
# ANTHROPIC_MODEL=claude-sonnet-5-5               # agent loop, judge, final compile, document & image description
# ANTHROPIC_EFFORT=high                           # output_config.effort for ANTHROPIC_MODEL: low | medium | high | xhigh | max
# ANTHROPIC_EFFORT_LIGHT=low                      # effort when the user's Thinking setting is off, and for judge / image & document descriptions
# ANTHROPIC_MAX_TOKENS=64000                      # max_tokens with Thinking on (thinking tokens count against it; the loop streams)
# ANTHROPIC_MAX_TOKENS_LIGHT=16000                # max_tokens with Thinking off
# ANTHROPIC_MAX_TOKENS_FAST=16000                 # max_tokens for subagents on the fast model
# ANTHROPIC_MAX_TOKENS_FAST_SHORT=2048            # max_tokens for short fast-model answers (topic, summary, classifier)
# PROMPT_CACHING=true                             # cache the static system prompt + conversation prefix (transcript mode)
# SYSTEM_CACHE_TTL=1h                             # 5m | 1h: TTL of the system-prompt cache breakpoint
# THINKING_PREFIX_MISMATCH=drop_block             # stale thinking blocks: drop_block | error (find history edits) | off
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5           # topic/summary, complexity classifier, "simple" answers (no effort/thinking param)
# OPENAI_MODEL=gpt-6.1-sol                        # critique + GPT vision on photos (reasoning model)
# VIDEO_FRAMES_MODEL=gpt-6-luna                   # video frame description (reasoning model)
# OPENAI_REASONING_EFFORT=high                    # reasoning_effort for the two OpenAI reasoning models above
# WHISPER_MODEL=whisper-1                         # voice / video transcription
# EMBEDDING_MODEL=text-embedding-3-small          # FAISS memory embeddings; a change rebuilds every index; EMBEDDING_DIMENSION must match
# EMBEDDING_DIMENSION=1536
# GEMINI_IMAGE_MODEL_FLASH=gemini-3.1-flash-image-preview   # image tools "Normal" mode
# GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image-preview         # image tools "Pro" mode
# GPT_IMAGE_MODEL=gpt-image-2.5-sunburst                    # image engine 'auto'/'best': most capable
# GPT_IMAGE_MODEL_FAST=gpt-image-2.5-flare                  # image engine 'fast': quicker, lower quality, same price
# VEO_MODEL=veo-3.1-generate-preview                        # all five video tools
# PERPLEXITY_MODEL=sonar                                    # deep_research default: sonar | sonar-pro | sonar-reasoning-pro
# TTS_MODEL=eleven_multilingual_v2                          # ElevenLabs voice replies

# Concurrency: every user has an isolated queue; these cap the whole process
MAX_CONCURRENT_TURNS=8          # agent turns running at the same time across all users
MAX_SANDBOX_CONTAINERS=4        # sandbox Docker containers running at the same time
TURN_TIMEOUT_SECONDS=1800       # a single turn (message/reminder) is stopped after this
THREAD_POOL_SIZE=32             # threads for blocking work (Docker waits, HTTP SDKs, ffmpeg); keep > MAX_CONCURRENT_TURNS
DROP_PENDING_UPDATES=true       # discard messages that arrived while the bot was down
STREAMING_ENABLED=true          # stream partial answers as Telegram draft messages (on by default; false = answers arrive whole)

# Persistent sandbox sessions and the interactive browser (optional; defaults shown, 0 = auto from the server's memory)
# SANDBOX_SESSIONS=true                  # one long-lived sandbox container per user; false = a throwaway container per command
# SANDBOX_IDLE_SECONDS=1800              # an unused sandbox / browser closes after this (workspace files and saved logins stay)
# SANDBOX_WARN_BEFORE_SECONDS=300        # the user gets a "closing soon" message with a Keep open button this long before
# SANDBOX_SESSION_MEM_MB=768             # memory limit of one sandbox container
# BROWSER_MEM_MB=1536                    # memory limit of one browser container (Chromium)
# SANDBOX_MEMORY_RESERVE_MB=1536         # kept free for the OS, the bot and the Bot API server; no session starts below it
# SANDBOX_MAX_SESSIONS=0                 # sandboxes running at once (0 = as many as the memory allows, at most 16)
# BROWSER_MAX_SESSIONS=0                 # browsers running at once (0 = as many as the memory allows, at most 8)
# SANDBOX_NETWORK=generall-sandbox       # Docker bridge network of the sessions (created when missing)
# SANDBOX_SUBNET=172.30.240.0/24         # its subnet; must not overlap your other Docker or LAN networks
# SANDBOX_EGRESS_FILTER=best_effort      # block private/local addresses from the sandbox via iptables: best_effort | required | off
# SANDBOX_DNS=1.1.1.1,8.8.8.8            # DNS servers of the sandboxes (the filter blocks private resolvers); empty = Docker's default

# MCP servers offered to every user (optional). JSON {"servers": [{"name", "url", "transport": "http"|"sse", "headers": {...}, "enabled": true}]},
# hand-edited; the bot keeps the discovered tools next to it in <name>.cache.json. Users add their own servers with /mcp.
# MCP_SERVERS_FILE=data/mcp_servers.json

# S3 Storage Configuration
S3_HOST=your_s3_host_url
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET_NAME=your_bucket_name
S3_PATH_TO_STORE=your_storage_path

# Browser Service Configuration
BROWSER_SERVICE_URL=http://browser-service:3000

# For local Telegram Bot API server config
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_USE_LOCAL_API=true
TELEGRAM_LOCAL_API_URL=http://localhost:8081

# Image Processing Configuration
MAX_IMAGE_RESOLUTION_VISION=1024
MAX_IMAGE_RESOLUTION_EDIT=4096
